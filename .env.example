# Copiar a .env y ajustar valores antes de desplegar en producción

PORT=5000
NODE_ENV=development

# Orígenes permitidos por CORS (producción + desarrollo local)
# En producción debe incluir el dominio de Vercel, separado por comas.
CORS_ORIGIN=https://recursos-docentes-aip.vercel.app,http://localhost:5173

# Direcciones o CIDR de proxies de confianza, según el despliegue.
TRUSTED_PROXIES=

# CA opcional de PostgreSQL para instalaciones con autoridad privada.
DATABASE_CA_CERT=

# Habilita el contenido de demostración solo en desarrollo.
SEED_DEMO_CONTENT=0

# Estas variables se usan solo al ejecutar npm run admin:provision.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# URL de conexión a PostgreSQL (Supabase Transaction Pooler)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Credenciales de Supabase Storage
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Nombre del bucket de Supabase Storage (opcional, default: recursos-uploads)
# SUPABASE_STORAGE_BUCKET=recursos-uploads

# Google Drive - API Key (opcional, para galerías vinculadas por carpeta)
# 1. API Key creada en Google Cloud Console con Google Drive API habilitada
# 2. Restricciones de referente: https://recursos-docentes-aip.vercel.app/* y http://localhost:5173/*
# 3. Cada evidencia puede vincular una carpeta pública distinta (no se configura aquí)
VITE_GOOGLE_API_KEY=
